
index.local.html

# Raw source ebooks — keep out of the public Pages build.
/public/raw-books/

# The epub drop folder (tools/epub-import.py): the .epub files and its import
# log stay local; only the converted markdown in library/ is committed.
/public/epub/*.epub
/public/epub/.imported.json

# Site-lock token — kept out of the (public) repo on purpose. Local builds read
# it from this file; CI reads it from the SITE_ACCESS_TOKEN repo secret instead.
# See tools/build-reader.py's load_access_token().
/tools/access-config.json

# Bytecode cache from the tools/ scripts.
__pycache__/
